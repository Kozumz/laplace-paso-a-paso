{
  "name": "laplace-paso-a-paso",
  "version": "1.0.0",
  "description": "App interactiva para estudiar transformada de Laplace: resolvedor paso a paso de sistemas mecánicos rotacionales, circuitos e inversas.",
  "author": "Carlos Josué Moreno Mireles",
  "license": "MIT",
  "private": true,
  "main": "server/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test tests/*.test.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "katex": "^0.16.9"
  }
}
